#include <stdio.h>

int main() {
    float num1, num2, total;
    
    printf("Enter the first number: ");
    scanf("%f", &num1);
    
    printf("Enter the second number: ");
    scanf("%f", &num2);
    
    total = num1 + num2;
    
    printf("The sum of the two numbers is: %.2f\n", total);
    
    return 0;
}
