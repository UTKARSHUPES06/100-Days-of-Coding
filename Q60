#include <stdio.h>

int main() {
    int n;
    int arr[100];
    int pos_count = 0, neg_count = 0, zero_count = 0;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    if (n <= 0) {
        return 0;
    }

    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        if (arr[i] > 0) {
            pos_count++;
        } else if (arr[i] < 0) {
            neg_count++;
        } else {
            zero_count++;
        }
    }

    printf("Total positive numbers = %d\n", pos_count);
    printf("Total negative numbers = %d\n", neg_count);
    printf("Total zero elements = %d\n", zero_count);

    return 0;
}
