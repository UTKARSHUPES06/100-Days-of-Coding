#include <stdio.h>

int main() {
    int n, temp, firstDigit, lastDigit, multiplier = 1, middlePart, swappedNum, isNegative = 0;

    printf("Enter an integer: ");
    scanf("%d", &n);

    if (n < 0) {
        isNegative = 1;
        n = -n;
    }

    if (n < 10) {
        if (isNegative) {
            printf("Swapped number: -%d\n", n);
        } else {
            printf("Swapped number: %d\n", n);
        }
        return 0;
    }

    lastDigit = n % 10;
    temp = n;

    while (temp >= 10) {
        temp /= 10;
        multiplier *= 10;
    }
    firstDigit = temp;

    middlePart = (n % multiplier) / 10;

    swappedNum = lastDigit * multiplier + middlePart * 10 + firstDigit;

    if (isNegative) {
        swappedNum = -swappedNum;
    }

    printf("Swapped number: %d\n", swappedNum);

    return 0;
}
