#include <stdio.h>

int main() {
    int n, remainder;
    long long product = 1;
    int has_odd = 0;

    printf("Enter an integer: ");
    scanf("%d", &n);

    if (n < 0) {
        n = -n;
    }

    if (n == 0) {
        printf("No odd digits found.\n");
        return 0;
    }

    while (n != 0) {
        remainder = n % 10;
        if (remainder % 2 != 0) {
            product *= remainder;
            has_odd = 1;
        }
        n /= 10;
    }

    if (has_odd) {
        printf("Product of odd digits = %lld\n", product);
    } else {
        printf("No odd digits found.\n");
    }

    return 0;
}
